<mujoco model="humanoid_lab_biped">
  <!--
    Simplified 12-DOF biped (Stage 1-2 development model, per the
    HUMANOID-LAB proposal: "start with a simplified biped model for
    control development, then progress to the G1"). Link lengths here
    (thigh=0.30 m, shank=0.30 m, hip_width=0.20 m) MUST match
    humanoid_kinematics/planar_leg.py and humanoid_description/urdf; see
    tests/test_sim_consistency.py, which checks the three stay in sync.

    JOINT SIGN CONVENTION (matches humanoid_kinematics.planar_leg):
    hip_pitch / knee_pitch / ankle_pitch all rotate about axis (0 -1 0),
    so that positive hip_pitch swings the thigh forward (+x); this is
    the opposite sign to MuJoCo's default (0 1 0) hinge convention, so
    do not "simplify" this axis without re-deriving the kinematics.
    hip_roll / hip_yaw are mirrored left/right so that a positive command
    means the same physical direction (e.g. "roll outward") on both legs.
  -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="0.5" armature="0.01" frictionloss="0.1"/>
    <geom contype="0" conaffinity="0" friction="0.9 0.01 0.01" rgba="0.6 0.6 0.65 1"/>
    <position kp="100" ctrlrange="-3.14 3.14" forcerange="-70 70"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" contype="1" conaffinity="1" type="plane" size="5 5 0.1" rgba="0.3 0.3 0.32 1" friction="1.0 0.01 0.01"/>

    <body name="torso" pos="0 0 0.58">
      <!-- fixed-base rig: torso constrained to world for stepping integration tests -->
      <geom name="torso_geom" type="box" size="0.09 0.14 0.18" pos="0 0 0.10" mass="12.0"/>
      <site name="imu_site" pos="0 0 0.15" size="0.01"/>

      <!-- ===================== RIGHT LEG (y negative) ===================== -->
      <body name="right_hip_yaw" pos="0 -0.10 0">
        <joint name="right_hip_yaw_joint" type="hinge" axis="0 0 1" range="-0.6 0.6"/>
        <geom type="sphere" size="0.035" mass="0.4"/>
        <body name="right_hip_roll">
          <joint name="right_hip_roll_joint" type="hinge" axis="1 0 0" range="-0.5 0.5"/>
          <geom type="sphere" size="0.035" mass="0.4"/>
          <body name="right_hip_pitch">
            <joint name="right_hip_pitch_joint" type="hinge" axis="0 -1 0" range="-1.8 1.2"/>
            <geom name="right_thigh_geom" type="cylinder" size="0.045" fromto="0 0 0 0 0 -0.30" mass="3.0"/>
            <body name="right_knee_pitch" pos="0 0 -0.30">
              <joint name="right_knee_pitch_joint" type="hinge" axis="0 -1 0" range="0.0 2.5"/>
              <geom name="right_shank_geom" type="cylinder" size="0.035" fromto="0 0 0 0 0 -0.30" mass="2.0"/>
              <body name="right_ankle_pitch" pos="0 0 -0.30">
                <joint name="right_ankle_pitch_joint" type="hinge" axis="0 -1 0" range="-1.0 1.0"/>
                <geom type="sphere" size="0.02" mass="0.15"/>
                <body name="right_ankle_roll">
                  <joint name="right_ankle_roll_joint" type="hinge" axis="1 0 0" range="-0.5 0.5"/>
                  <geom name="right_foot_geom" contype="1" conaffinity="1" type="box" size="0.11 0.05 0.015" pos="0.03 0 -0.015" mass="0.5"/>
                  <site name="right_foot_site" pos="0.03 0 -0.03" size="0.01"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ===================== LEFT LEG (y positive, mirrored roll/yaw) ===================== -->
      <body name="left_hip_yaw" pos="0 0.10 0">
        <joint name="left_hip_yaw_joint" type="hinge" axis="0 0 -1" range="-0.6 0.6"/>
        <geom type="sphere" size="0.035" mass="0.4"/>
        <body name="left_hip_roll">
          <joint name="left_hip_roll_joint" type="hinge" axis="-1 0 0" range="-0.5 0.5"/>
          <geom type="sphere" size="0.035" mass="0.4"/>
          <body name="left_hip_pitch">
            <joint name="left_hip_pitch_joint" type="hinge" axis="0 -1 0" range="-1.8 1.2"/>
            <geom name="left_thigh_geom" type="cylinder" size="0.045" fromto="0 0 0 0 0 -0.30" mass="3.0"/>
            <body name="left_knee_pitch" pos="0 0 -0.30">
              <joint name="left_knee_pitch_joint" type="hinge" axis="0 -1 0" range="0.0 2.5"/>
              <geom name="left_shank_geom" type="cylinder" size="0.035" fromto="0 0 0 0 0 -0.30" mass="2.0"/>
              <body name="left_ankle_pitch" pos="0 0 -0.30">
                <joint name="left_ankle_pitch_joint" type="hinge" axis="0 -1 0" range="-1.0 1.0"/>
                <geom type="sphere" size="0.02" mass="0.15"/>
                <body name="left_ankle_roll">
                  <joint name="left_ankle_roll_joint" type="hinge" axis="-1 0 0" range="-0.5 0.5"/>
                  <geom name="left_foot_geom" contype="1" conaffinity="1" type="box" size="0.11 0.05 0.015" pos="0.03 0 -0.015" mass="0.5"/>
                  <site name="left_foot_site" pos="0.03 0 -0.03" size="0.01"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="right_hip_yaw_act"    joint="right_hip_yaw_joint"/>
    <position name="right_hip_roll_act"   joint="right_hip_roll_joint"/>
    <position name="right_hip_pitch_act"  joint="right_hip_pitch_joint" kp="300" forcerange="-100 100"/>
    <position name="right_knee_pitch_act" joint="right_knee_pitch_joint" kp="300" forcerange="-100 100"/>
    <position name="right_ankle_pitch_act" joint="right_ankle_pitch_joint" kp="120" forcerange="-50 50"/>
    <position name="right_ankle_roll_act" joint="right_ankle_roll_joint"/>
    <position name="left_hip_yaw_act"     joint="left_hip_yaw_joint"/>
    <position name="left_hip_roll_act"    joint="left_hip_roll_joint"/>
    <position name="left_hip_pitch_act"   joint="left_hip_pitch_joint" kp="300" forcerange="-100 100"/>
    <position name="left_knee_pitch_act"  joint="left_knee_pitch_joint" kp="300" forcerange="-100 100"/>
    <position name="left_ankle_pitch_act" joint="left_ankle_pitch_joint" kp="120" forcerange="-50 50"/>
    <position name="left_ankle_roll_act"  joint="left_ankle_roll_joint"/>
  </actuator>

  <sensor>
    <framequat name="torso_quat" objtype="site" objname="imu_site"/>
    <gyro name="torso_gyro" site="imu_site"/>
    <accelerometer name="torso_accel" site="imu_site"/>
    <touch name="right_foot_touch" site="right_foot_site"/>
    <touch name="left_foot_touch" site="left_foot_site"/>
  </sensor>
</mujoco>
