<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>humanoid_benchmarks</name>
  <version>0.1.0</version>
  <description>Rosbag/CSV logging, offline metrics (tracking error, standing duration, push-recovery rate) and plotting.</description>
  <maintainer email="maintainers@users.noreply.github.com">HUMANOID-LAB contributors</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>humanoid_motion_controller</exec_depend>
  <exec_depend>humanoid_gait_planner</exec_depend>
  <exec_depend>humanoid_sim</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
