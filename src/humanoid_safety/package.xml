<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>humanoid_safety</name>
  <version>0.1.0</version>
  <description>Fault-aware safety supervisor FSM (STAND/WALK/FAULT_DETECTED/RECOVERY/SAFE_HOLD) and a fault-injection node.</description>
  <maintainer email="maintainers@users.noreply.github.com">HUMANOID-LAB contributors</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
