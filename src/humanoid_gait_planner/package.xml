<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>humanoid_gait_planner</name>
  <version>0.1.0</version>
  <description>Footstep sequence generator and minimum-jerk swing-foot trajectory generator; publishes per-step foot targets.</description>
  <maintainer email="maintainers@users.noreply.github.com">HUMANOID-LAB contributors</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>humanoid_kinematics</depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
