<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>humanoid_mission_manager</name>
  <version>0.1.0</version>
  <description>Top-level mission sequencer (Stand -> Shift -> Step -> Walk -> Stop), safety-state aware.</description>
  <maintainer email="maintainers@users.noreply.github.com">HUMANOID-LAB contributors</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>humanoid_safety</depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
